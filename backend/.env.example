# SafeSphere Backend Environment Template
# Duplicate this file as '.env' and populate with your credentials.

# Database URI
MONGODB_URI=mongodb://localhost:27017/disasterconnect

# Secret used to sign JSON Web Tokens
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY

# Token expiration duration (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Server listener port
PORT=5000

# Environment state (development, production)
NODE_ENV=development

# Allowed client origin URL (for CORS)
CLIENT_URL=http://localhost:3000

# Secret required in the x-iot-api-key header for every device telemetry request.
# Generate a unique long random value for each environment; never commit the real key.
IOT_API_KEY=REPLACE_WITH_A_LONG_RANDOM_IOT_DEVICE_KEY
