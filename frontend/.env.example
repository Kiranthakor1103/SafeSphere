# SafeSphere Frontend Environment Template
# Duplicate this file as '.env' and populate with your actual keys.
# DO NOT commit '.env' containing real secrets to version control.

# Backend API Root URL
VITE_API_BASE_URL=http://localhost:5000/api

# Google Services Keys
VITE_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Integrations & Externals
VITE_PROPERTY_LINK=http://localhost:3000/property-details
VITE_MIXPANEL_TOKEN=YOUR_MIXPANEL_PROJECT_TOKEN
VITE_STRIPE_PUBLIC_KEY=pk_test_YOUR_STRIPE_PUBLIC_KEY
